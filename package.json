{
  "name": "shopforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint ./shopforge/webapp/src",
    "lint-fix": "eslint ./shopforge/webapp/src --fix",
    "format": "prettier --write \"shopforge/webapp/src/**/*.{vue,ts,js,css,scss}\"",
    "gen-types": "openapi-typescript schema.yaml -o shopforge/webapp/src/types/schema.d.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@mdi/font": "^7.4.0",
    "axios": "^1.18.1",
    "pinia": "^2.1.7",
    "vue": "^3.5.39",
    "vue-router": "^4.3.0",
    "vuetify": "^3.5.0"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "eslint-plugin-vue": "^9.22.0",
    "jsdom": "^24.0.0",
    "npm-run-all2": "^6.1.0",
    "openapi-typescript": "^6.7.0",
    "postcss": "^8.4.0",
    "prettier": "^3.9.1",
    "sass": "^1.101.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.4.0",
    "vite": "^5.1.0",
    "vite-plugin-vuetify": "^2.0.0",
    "vitest": "^1.3.0",
    "vue-tsc": "^2.0.0"
  }
}
